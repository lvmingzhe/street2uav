@@ -55,7 +56,7 @@
         self.proj_drop = nn.Dropout(proj_drop)
 
     def init_weights(
-        self, init_attn_std: float | None = None, init_proj_std: float | None = None, factor: float = 1.0
+        self, init_attn_std: "Optional[float]" = None, init_proj_std: "Optional[float]" = None, factor: float = 1.0
     ) -> None:
         init_attn_std = init_attn_std or (self.dim**-0.5)
         init_proj_std = init_proj_std or init_attn_std * factor
@@ -71,9 +72,28 @@
         qkv = self.qkv(x).reshape(B, N, 3, self.num_heads, C // self.num_heads)
         q, k, v = torch.unbind(qkv, 2)
         q, k, v = [t.transpose(1, 2) for t in [q, k, v]]
-        x = nn.functional.scaled_dot_product_attention(
-            q, k, v, attn_mask=None, dropout_p=self.attn_drop if self.training else 0, is_causal=is_causal
-        )
+        # PyTorch 1.10 compat: F.scaled_dot_product_attention is in 2.0+.
+        # Manual SDPA implementation matching PyTorch's reference.
+        if hasattr(nn.functional, "scaled_dot_product_attention"):
+            x = nn.functional.scaled_dot_product_attention(
+                q, k, v, attn_mask=None,
+                dropout_p=self.attn_drop if self.training else 0,
+                is_causal=is_causal,
+            )
+        else:
+            head_dim = q.size(-1)
+            scale = head_dim ** -0.5
+            attn = (q * scale) @ k.transpose(-2, -1)
+            if is_causal:
+                # build causal mask [N, N]
+                mask = torch.triu(
+                    torch.ones(N, N, dtype=torch.bool, device=q.device), diagonal=1
+                )
+                attn = attn.masked_fill(mask, float("-inf"))
+            attn = attn.softmax(dim=-1)
+            if self.training and self.attn_drop > 0:
+                attn = nn.functional.dropout(attn, p=self.attn_drop, training=True)
+            x = attn @ v
         x = x.transpose(1, 2).contiguous().view(B, N, C)
         x = self.proj_drop(self.proj(x))
         return x
